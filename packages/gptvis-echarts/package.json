{
  "name": "gptvis-echarts",
  "version": "0.2.0",
  "description": "ECharts adapter for GPT-Vis. Same vis syntax, GPTVis class, and chart constructors, rendered with Apache ECharts.",
  "keywords": ["gpt-vis", "echarts", "vis", "llm", "charts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzc520pyfm/GPT-Vis-ECharts.git",
    "directory": "packages/gptvis-echarts"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "src", "skills"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run && npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "echarts": "^5.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
