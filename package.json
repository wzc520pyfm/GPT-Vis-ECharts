{
  "name": "gptvis-echarts",
  "version": "0.2.0",
  "description": "AI-native vis syntax rendered with Apache ECharts. Compatible with the GPT-Vis grammar, without AntV.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "src", "skills"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4317 --strictPort",
    "build": "tsc -p tsconfig.lib.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "echarts": "^5.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
